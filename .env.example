# ============================================================
# MẪU cấu hình môi trường — SAO CHÉP sang .env rồi sửa giá trị.
#   cp .env.example .env
# .env KHÔNG được commit (đã nằm trong .gitignore).
# Giá trị dưới đây chỉ dùng cho máy dev local.
# ============================================================

# --- Ứng dụng ---
APP_ENV=dev
APP_NAME=CafeTLU

# --- MySQL (chạy qua docker compose) ---
# Cổng 3307 để không đụng MySQL cài sẵn trên máy.
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=root
DB_PASSWORD=cafetlu_dev_root
DB_NAME=cafe_tlu
MYSQL_ROOT_PASSWORD=cafetlu_dev_root
MYSQL_DATABASE=cafe_tlu

# --- API ---
API_HOST=127.0.0.1
API_PORT=8000
API_BASE_URL=http://127.0.0.1:8000/api/v1

# --- Bảo mật (ĐỔI trước khi deploy; đừng dùng giá trị này ở production) ---
JWT_SECRET=change_me_local_only_please_replace
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=30
JWT_REFRESH_DAYS=7

# --- Ghi log ---
LOG_LEVEL=INFO
